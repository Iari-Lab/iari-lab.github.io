# Cloudflare Pages: response headers by path (GitHub Pages ignores this file).
# Later rules add to earlier ones; "! Name" drops a header inherited from an earlier rule.
#
# The Content-Security-Policy is REPORT-ONLY until it has been checked on the live site:
# open www.iari.io, press "Allow", play a video, open live/ and connect to a camera, and look
# for CSP messages in the browser console. Then rename the header to Content-Security-Policy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# IARI Live (branch live-app): no inline scripts, and the stream is a WebSocket to the camera
# on the visitor's own network (ws:// to a private IP, or wss:// to the camera's name).
/live/*
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# The service worker must be revalidated on every load, or installed copies never see an update.
/live/sw.js
  Cache-Control: no-cache

# Versioned, never-changing files: the self-hosted fonts and the vendored chart library.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/live/vendor/*
  Cache-Control: public, max-age=31536000, immutable
